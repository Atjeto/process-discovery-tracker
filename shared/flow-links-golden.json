{
  "about": "Contract C17 (step flow): the edges the process map draws from the transactions' step order plus the conditions and links the analyst sets on steps. Pinned for both renderers: the viewer's live map (viewer/process-map-levels.js) and the pipeline's step BPMN (normalization). A step is named here by its map node name; real data links by step_id. observed: the edge follows from the step order of at least one transaction. label: the analyst's condition text (only_when on the step the edge enters, or a link's when), 'otherwise' on the path around a conditional step, or null. Consecutive steps with one node are one visit, as on the map, so the previous step and the step after are the neighbouring visits; a path around a step between two visits of one node would join them into one visit and is not drawn. A condition set on a step holds for its node in every transaction. A hidden step is not on the map, and a link to it, to its own step or to no step draws nothing; a link without a when is an edge with no label. Lane FX1: a case with `excluded_ranges` gives `run_spans` (each transaction's start and end, in order) and steps with a `time_range`: each range cut to a transaction's span is a stretch left out of the analysis, which cuts that transaction's trace. A stretch falls between the steps as the differences place it (a step is before it when it starts before the stretch starts; a step without a time is after it), and no edge crosses it: not from the step before it to the step after it, not from the start into the first step after a stretch that opens the transaction, not from the last step before a stretch that closes it into the end. A step next to a cut has no previous step (or no step after it) on that side, so a condition labels no edge there.",
  "cases": [
    {
      "name": "one transaction: a conditional step and a loop back",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B", "only_when": "X"},
          {"name": "C"},
          {"name": "D", "links": [{"to": "B", "when": "check fails"}]}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": "X", "observed": true},
        {"from": "A", "to": "C", "label": "otherwise", "observed": false},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "D", "label": null, "observed": true},
        {"from": "D", "to": "B", "label": "check fails", "observed": false},
        {"from": "D", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "the first step is conditional",
      "transactions": [
        [
          {"name": "A", "only_when": "Y"},
          {"name": "B"},
          {"name": "C"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": "Y", "observed": true},
        {"from": "start", "to": "B", "label": "otherwise", "observed": false},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "the last step is conditional",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B"},
          {"name": "C", "only_when": "Z"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "C", "label": "Z", "observed": true},
        {"from": "B", "to": "end", "label": "otherwise", "observed": false},
        {"from": "C", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "a step can end the process early",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B", "links": [{"to": "end", "when": "rejected"}]},
          {"name": "C"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "B", "to": "end", "label": "rejected", "observed": false},
        {"from": "C", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "a skip forward over two steps",
      "transactions": [
        [
          {"name": "A", "links": [{"to": "D", "when": "known customer"}]},
          {"name": "B"},
          {"name": "C"},
          {"name": "D"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "A", "to": "D", "label": "known customer", "observed": false},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "D", "label": null, "observed": true},
        {"from": "D", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "two recorded transactions: a declared condition labels the observed branch",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B"},
          {"name": "D"}
        ],
        [
          {"name": "A"},
          {"name": "B"},
          {"name": "C", "only_when": "new product code"},
          {"name": "D"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "C", "label": "new product code", "observed": true},
        {"from": "B", "to": "D", "label": "otherwise", "observed": true},
        {"from": "C", "to": "D", "label": null, "observed": true},
        {"from": "D", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "the same declaration on the same step in two transactions is drawn once",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B", "links": [{"to": "A", "when": "missing data"}]}
        ],
        [
          {"name": "A"},
          {"name": "B", "links": [{"to": "A", "when": "missing data"}]}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "A", "label": "missing data", "observed": false},
        {"from": "B", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "different labels on one edge are joined with or, in step order",
      "transactions": [
        [
          {"name": "A", "links": [{"to": "C", "when": "known customer"}]},
          {"name": "B", "only_when": "a new customer"},
          {"name": "C"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": "a new customer", "observed": true},
        {"from": "A", "to": "C", "label": "known customer or otherwise", "observed": false},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "consecutive steps with one node are one visit",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B"},
          {"name": "B", "only_when": "X"},
          {"name": "C"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": "X", "observed": true},
        {"from": "A", "to": "C", "label": "otherwise", "observed": false},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "a condition holds in every transaction where its step appears",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B", "only_when": "X"},
          {"name": "C"}
        ],
        [
          {"name": "D"},
          {"name": "B"},
          {"name": "C"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "start", "to": "D", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": "X", "observed": true},
        {"from": "D", "to": "B", "label": "X", "observed": true},
        {"from": "A", "to": "C", "label": "otherwise", "observed": false},
        {"from": "D", "to": "C", "label": "otherwise", "observed": false},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "no path around a step between two visits of one step",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B", "only_when": "X"},
          {"name": "A"}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": "X", "observed": true},
        {"from": "B", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "a hidden step is not drawn, a link to it draws nothing, a link without a when has no label",
      "transactions": [
        [
          {"name": "A"},
          {"name": "B"},
          {"name": "C", "state": "hidden"},
          {"name": "D", "links": [{"to": "C", "when": "never drawn"}, {"to": "A", "when": ""}]}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "D", "label": null, "observed": true},
        {"from": "D", "to": "A", "label": null, "observed": false},
        {"from": "D", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "a stretch left out at a transaction's start: no path from the start into the step after it",
      "excluded_ranges": [{"start": "2026-05-14T09:00:55Z", "end": "2026-05-14T09:01:35Z"}],
      "run_spans": [{"start": "2026-05-14T09:00:00Z", "end": "2026-05-14T09:00:50Z"}, {"start": "2026-05-14T09:01:00Z", "end": "2026-05-14T09:02:00Z"}],
      "transactions": [
        [
          {"name": "Search", "time_range": {"start": "2026-05-14T09:00:10Z", "end": "2026-05-14T09:00:10Z"}},
          {"name": "Open", "time_range": {"start": "2026-05-14T09:00:20Z", "end": "2026-05-14T09:00:20Z"}},
          {"name": "Enter", "time_range": {"start": "2026-05-14T09:00:30Z", "end": "2026-05-14T09:00:30Z"}},
          {"name": "Send", "time_range": {"start": "2026-05-14T09:00:40Z", "end": "2026-05-14T09:00:40Z"}}
        ],
        [
          {"name": "Enter", "time_range": {"start": "2026-05-14T09:01:40Z", "end": "2026-05-14T09:01:40Z"}},
          {"name": "Send", "time_range": {"start": "2026-05-14T09:01:50Z", "end": "2026-05-14T09:01:50Z"}}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "Search", "label": null, "observed": true},
        {"from": "Search", "to": "Open", "label": null, "observed": true},
        {"from": "Open", "to": "Enter", "label": null, "observed": true},
        {"from": "Enter", "to": "Send", "label": null, "observed": true},
        {"from": "Send", "to": "end", "label": null, "observed": true}
      ]
    },
    {
      "name": "a stretch between two steps: no edge across it, and the step after it has no previous step; one after the last step: no edge into the end",
      "excluded_ranges": [{"start": "2026-05-14T09:01:25Z", "end": "2026-05-14T09:01:35Z"}, {"start": "2026-05-14T09:01:45Z", "end": "2026-05-14T09:01:55Z"}],
      "run_spans": [{"start": "2026-05-14T09:00:00Z", "end": "2026-05-14T09:00:50Z"}, {"start": "2026-05-14T09:01:00Z", "end": "2026-05-14T09:02:00Z"}],
      "transactions": [
        [
          {"name": "A", "time_range": {"start": "2026-05-14T09:00:10Z", "end": "2026-05-14T09:00:10Z"}},
          {"name": "B", "time_range": {"start": "2026-05-14T09:00:20Z", "end": "2026-05-14T09:00:20Z"}},
          {"name": "C", "time_range": {"start": "2026-05-14T09:00:30Z", "end": "2026-05-14T09:00:30Z"}},
          {"name": "D", "time_range": {"start": "2026-05-14T09:00:40Z", "end": "2026-05-14T09:00:40Z"}, "only_when": "X"}
        ],
        [
          {"name": "A", "time_range": {"start": "2026-05-14T09:01:10Z", "end": "2026-05-14T09:01:10Z"}},
          {"name": "B", "time_range": {"start": "2026-05-14T09:01:20Z", "end": "2026-05-14T09:01:20Z"}},
          {"name": "D", "time_range": {"start": "2026-05-14T09:01:40Z", "end": "2026-05-14T09:01:40Z"}}
        ]
      ],
      "expected_edges": [
        {"from": "start", "to": "A", "label": null, "observed": true},
        {"from": "A", "to": "B", "label": null, "observed": true},
        {"from": "B", "to": "C", "label": null, "observed": true},
        {"from": "C", "to": "D", "label": "X", "observed": true},
        {"from": "C", "to": "end", "label": "otherwise", "observed": false},
        {"from": "D", "to": "end", "label": null, "observed": true}
      ]
    }
  ]
}
