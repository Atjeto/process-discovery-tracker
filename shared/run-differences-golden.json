        { "name": "Orders: Save", "draft_key": "crm|Orders|Button:save", "time_range": { "start": "2026-05-14T09:01:50Z", "end": "2026-05-14T09:01:55Z" } },
        { "name": "Compose: Send", "draft_key": "mail|Compose|Button:send", "time_range": { "start": "2026-05-14T09:02:00Z", "end": "2026-05-14T09:02:05Z" } }
      ],
      "run_keys": [
        "draft:crm|Orders|Button:find",
        "draft:crm|Orders|Button:save",
        "draft:mail|Compose|Button:send"
