      "name": "an order change",
      "pattern": [
        { "name": "Look up the order", "draft_key": "crm|Orders|Button:find" },
        { "name": "Save the order", "draft_key": "crm|Orders|Button:save" },
        { "name": "Send the confirmation", "draft_key": "mail|Compose|Button:send" }
      ],
      "run": [
