        { "name": "Send the confirmation", "draft_key": "mail|Compose|Button:send" }
      ],
      "run": [
        { "name": "Log book", "draft_key": "excel|Log book|(visit)" },
        { "name": "Orders: Find", "draft_key": "crm|Orders|Button:find" },
        { "name": "Orders: Save", "draft_key": "crm|Orders|Button:save" },
        { "name": "Log book: Save", "draft_key": "excel|Log book|Button:save" },
        { "name": "Compose: Send", "draft_key": "mail|Compose|Button:send" }
      ],
      "run_keys": [
        "draft:excel|Log book|(visit)",
        "draft:crm|Orders|Button:find",
        "draft:crm|Orders|Button:save",
        "draft:excel|Log book|Button:save",
        "draft:mail|Compose|Button:send"
      ],
      "expected": [
        "Extra step: Log book (at the start of the run).",
        "Extra step: Log book: Save (after Orders: Save)."
      ]
    },
    {
      "name": "a skipped step names its number in the pattern run",
      "pattern": [
        { "name": "Look up the order", "draft_key": "crm|Orders|Button:find" },
        { "name": "Save the order", "draft_key": "crm|Orders|Button:save" },
        { "name": "Send the confirmation", "draft_key": "mail|Compose|Button:send" }
      ],
      "run": [
        { "name": "Orders: Find", "draft_key": "crm|Orders|Button:find" },
        { "name": "Compose: Send", "draft_key": "mail|Compose|Button:send" }
      ],
      "run_keys": [
        "draft:crm|Orders|Button:find",
        "draft:mail|Compose|Button:send"
      ],
      "expected": [
