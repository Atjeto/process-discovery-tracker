{
  "name": "process-discovery-tracker-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Worker-side capture tracker for process discovery. Polls active window, fires marker events, writes per-session JSONL.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package": "electron-packager . \"Process Discovery Tracker\" --platform=win32 --arch=x64 --overwrite --out=dist --extra-resource=tray-icon.png",
    "dist": "electron-builder --win --x64 --publish=never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "js-yaml": "^4.1.0",
    "obs-websocket-js": "^5.0.6",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.processdiscovery.tracker",
    "productName": "Process Discovery Tracker",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "tracker.js",
      "session.js",
      "events.js",
      "config.js",
      "obs.js",
      "screenshots.js",
      "status-window.js",
      "help-window.js",
      "operator-panel.js",
      "sample-config.yaml",
      "tray-icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Process Discovery Tracker"
    }
  }
}
