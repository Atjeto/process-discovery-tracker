{
  "name": "process-discovery-tracker-capture",
  "version": "0.14.3",
  "private": true,
  "description": "Worker-side capture tracker for process discovery. Polls active window, fires marker events, writes per-session JSONL.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:recorder": "dotnet publish recorder/Recorder.csproj -c Release -o recorder/publish",
    "prepackage": "npm run build:recorder",
    "package": "node build-package.js",
    "dist": "electron-builder --win --x64 --publish=never",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "js-yaml": "^4.1.0",
    "obs-websocket-js": "^5.0.6"
  },
  "overrides": {
    "tar": "^7.4.3",
    "cacache": "^18.0.4",
    "node-gyp": "^11.0.0",
    "make-fetch-happen": "^14.0.3",
    "http-proxy-agent": "^7.0.2",
    "@tootallnate/once": "npm:once@^1.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.processdiscovery.tracker",
    "productName": "Process Discovery Tracker",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "tracker.js",
      "session.js",
      "events.js",
      "config.js",
      "obs.js",
      "screenshots.js",
      "status-window.js",
      "help-window.js",
      "operator-panel.js",
      "recorder.js",
      "recorder/publish/**/*",
      "sample-config.yaml",
      "tray-icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "recorder/publish",
        "to": "recorder"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Process Discovery Tracker"
    }
  }
}
