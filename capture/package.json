{
  "name": "process-discovery-tracker-capture",
  "version": "2.0.4",
  "private": true,
  "description": "Worker-side capture tracker for process discovery. Polls active window, fires marker events, writes per-session JSONL.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:recorder": "dotnet publish recorder/Recorder.csproj -c Release -o recorder/publish",
    "prepackage": "npm run build:recorder",
    "package": "node build-package.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "js-yaml": "^4.1.0",
    "obs-websocket-js": "^5.0.6"
  },
  "overrides": {
    "ws": "8.21.0",
    "tar": "^7.4.3",
    "cacache": "^18.0.4",
    "node-gyp": "^11.0.0",
    "make-fetch-happen": "^14.0.3",
    "http-proxy-agent": "^7.0.2",
    "@tootallnate/once": "npm:once@^1.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^42.3.0"
  }
}
