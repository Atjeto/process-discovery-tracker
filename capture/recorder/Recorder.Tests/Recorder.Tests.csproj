<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Matches the recorder's TFM so the project reference resolves and the
         §11e OcrBridge's WinRT surface (Windows.Media.Ocr) is reachable from
         its bitmap-render test. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Transitively needs the UIA reference assemblies that the recorder
         pulls in via UseWPF (System.Windows.Automation). -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pdt.Recorder.Tests</RootNamespace>
    <AssemblyName>Recorder.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Renders the known-text bitmap that pins the OcrBridge core (§11e). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recorder.csproj" />
  </ItemGroup>
</Project>
