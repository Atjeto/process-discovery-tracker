<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Windows-SDK version moniker (…10.0.19041.0) projects the WinRT
         surface the §11e OCR last-resort bridge needs (Windows.Media.Ocr,
         a Win10+ system API). It does NOT change the runtime floor for the
         non-OCR path and adds no bundle (the OCR engine is a system
         component). See ADR-0023. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- UseWPF must be true to surface UIAutomationClient / UIAutomationTypes
         (System.Windows.Automation lives in the WPF framework reference set).
         We don't use WPF UI types; trimming is off so this only adds the
         reference assemblies, not arbitrary WPF runtime code. -->
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Pdt.Recorder</RootNamespace>
    <AssemblyName>recorder</AssemblyName>
  </PropertyGroup>
  <!-- The xUnit test project lives in the Recorder.Tests subfolder; keep
       its sources out of the production recorder's default-glob compile set. -->
  <ItemGroup>
    <Compile Remove="Recorder.Tests\**\*.cs" />
  </ItemGroup>
  <!-- GDI+ screen-region capture for the §11e OCR last rung (default-off).
       First-party Microsoft package over system GDI+; no native bundle. -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
