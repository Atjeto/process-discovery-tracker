{
  "name": "process-discovery-tracker-viewer",
  "version": "0.3.0",
  "private": true,
  "description": "Analyst-side viewer for process discovery sessions. Session view (video-synced timeline) + aggregate view (mined map + statistics + BPMN export).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package": "node build-package.js",
    "dist": "electron-builder --win --x64 --publish=never",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"timeline/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bpmn-js": "^17.9.1",
    "cytoscape": "^3.30.0",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/node": "^25.8.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.processdiscovery.viewer",
    "productName": "Process Discovery Viewer",
    "npmRebuild": false,
    "files": [
      "main.js",
      "python-runner.js",
      "index.html",
      "renderer.js",
      "charts.js",
      "dfg-viewer.js",
      "bpmn-viewer.js",
      "report-md.js",
      "step-editor.js",
      "phase-editor.js",
      "layout-controls.js",
      "command-palette.js",
      "timeline/timeline-core.js",
      "styles.css",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../normalization",
        "to": "normalization",
        "filter": [
          "**/*.py",
          "*.yaml",
          "*.txt",
          "!__pycache__/**"
        ]
      },
      {
        "from": "python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Process Discovery Viewer"
    }
  }
}
