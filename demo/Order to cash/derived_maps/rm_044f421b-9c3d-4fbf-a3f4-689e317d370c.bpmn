    </bpmn:startEvent>
    <bpmn:task id="node_1_Find_the_customer" name="Find the customer">
      <bpmn:documentation>Search the customer by name or customer number and select the account.
Order Desk, Customer lookup. In 4 of 4 transactions, 1s on average.</bpmn:documentation>
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="node_2_Enter_the_order" name="Enter the order">
      <bpmn:documentation>Order Desk, New order for Contoso Ltd. In 4 of 4 transactions, 7s on average.</bpmn:documentation>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:startEvent id="Sub1_node_0">
        <bpmn:outgoing>Sub1_flow_0</bpmn:outgoing>
      </bpmn:startEvent>
