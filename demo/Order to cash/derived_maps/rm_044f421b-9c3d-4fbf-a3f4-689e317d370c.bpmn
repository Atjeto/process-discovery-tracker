        <bpmn:incoming>Sub1_flow_1</bpmn:incoming>
        <bpmn:outgoing>Sub1_flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Sub1_node_2_Enter_Delivery_date" name="Enter Delivery date">
        <bpmn:documentation>Order Desk, New order for Contoso Ltd. In 4 of 4 transactions, under 1s on average.</bpmn:documentation>
        <bpmn:incoming>Sub1_flow_3</bpmn:incoming>
        <bpmn:outgoing>Sub1_flow_4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Sub1_node_3_Toggle_Standard" name="Toggle Standard">
        <bpmn:documentation>Order Desk, New order for Contoso Ltd. In 3 of 4 transactions, 3s on average.</bpmn:documentation>
        <bpmn:incoming>Sub1_flow_9</bpmn:incoming>
        <bpmn:outgoing>Sub1_flow_5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Sub1_node_4_Enter_Notes" name="Enter Notes">
        <bpmn:documentation>Order Desk, New order for Contoso Ltd. In 1 of 4 transactions, under 1s on average.</bpmn:documentation>
        <bpmn:incoming>Sub1_flow_10</bpmn:incoming>
        <bpmn:outgoing>Sub1_flow_11</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Sub1_node_5_Click_Save_order" name="Click Save order">
        <bpmn:documentation>Order Desk, New order for Contoso Ltd. In 4 of 4 transactions, under 1s on average.</bpmn:documentation>
        <bpmn:incoming>Sub1_flow_6</bpmn:incoming>
        <bpmn:outgoing>Sub1_flow_12</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub1_node_6">
        <bpmn:incoming>Sub1_flow_12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="Sub1_node_7_Enter_Product" name="Enter Product">
        <bpmn:documentation>Order Desk, New order for Northwind Traders. In 3 of 4 transactions, 2s on average.</bpmn:documentation>
