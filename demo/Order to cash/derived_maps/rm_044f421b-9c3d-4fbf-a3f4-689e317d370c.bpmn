    <bpmn:task id="node_3_Add_the_order_to_the_tracking_sh" name="Add the order to the tracking sheet">
      <bpmn:documentation>Type the new order as a row of the order tracking sheet (order, customer, item, quantity, unit price) and save the sheet. The weekly sales report reads it; every value is already in Order Desk.
Excel, order-tracking.xlsx. In 4 of 4 transactions, 5s on average.</bpmn:documentation>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="node_4_The_order_is_saved_in_Order_Desk" name="The order is saved in Order Desk and listed in the order tracking sheet.">
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="node_5_Print_the_order_confirmation" name="Print the order confirmation">
      <bpmn:documentation>Order Desk, Order saved. In 1 of 4 transactions, under 1s on average.</bpmn:documentation>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="node_6_Look_up_the_SAP_material" name="Look up the SAP material">
      <bpmn:documentation>Find the item's SAP material number in the material mapping file.
Notepad. In 1 of 4 transactions, 3s on average.</bpmn:documentation>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:property id="Property_node_6_Look_up_the_SAP_material" name="__targetRef_placeholder" />
