        <bpmn:targetRef>Property_node_6_Look_up_the_SAP_material</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="node_7_Create_the_new_customer" name="Create the new customer">
      <bpmn:documentation>Order Desk, New customer. In 1 of 4 transactions, 14s on average.</bpmn:documentation>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:task>
