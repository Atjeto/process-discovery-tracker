# Repo-root build outputs ONLY -- patterns leading with / so that
# `dist/`, `build/`, `out/`, etc. inside node_modules/<pkg>/ survive
# the asar packaging step (electron-packager honors .gitignore here
# and silently strips matching subfolders from the bundle, which left
# obs-websocket-js, bpmn-js, and cytoscape broken in packaged builds).
node_modules/
/dist/
/dist-electron/
/dist-packaged/
/build/
/out/
capture/dist/
capture/dist-electron/
viewer/dist/
viewer/dist-electron/

# Python bytecode caches
__pycache__/
*.pyc

# C# recorder build artifacts (also in capture/recorder/.gitignore)
capture/recorder/bin/
capture/recorder/obj/
capture/recorder/publish/

# Locally-trained ML models (built by --retrain-classifier + first ML run)
normalization/ml_models/

# Bundled python embeddable (built by scripts/build-python-embeddable.ps1 -- ~450 MB)
viewer/python/

# Staged at distribution-build time, deleted after; never checked in
viewer/normalization/

# Captured sessions are local data, not source
sessions/

# Generated icons
*.ico

# Logs and temp
*.log
boot.log
.DS_Store
Thumbs.db

# Env / local
.env
.env.local
.vscode/
.idea/
